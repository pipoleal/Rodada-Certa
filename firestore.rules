rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção "pontuacoes" do ranking global do quiz.
    // Um documento por jogador+categoria, ID "<uid>_<categoria>", que
    // acumula pontos a cada rodada em vez de criar uma linha nova.
    match /pontuacoes/{scoreId} {

      // Leitura pública: qualquer pessoa pode ver o ranking, mesmo sem login.
      allow read: if true;

      // Criação do documento (primeira rodada do jogador nesta categoria):
      // exige login (mesmo anônimo) e que o ID do documento pertença a
      // quem está escrevendo, além dos limites normais de formato/faixa.
      allow create: if
        request.auth != null &&
        scoreId == request.auth.uid + '_' + request.resource.data.categoria &&
        request.resource.data.keys().hasOnly(['categoria', 'nome', 'pontuacao', 'acertos', 'data']) &&

        request.resource.data.categoria is string &&
        request.resource.data.categoria in ['geral', 'geografia', 'ciencia', 'entretenimento', 'esportes'] &&

        request.resource.data.nome is string &&
        request.resource.data.nome.size() > 0 &&
        request.resource.data.nome.size() <= 20 &&

        request.resource.data.pontuacao is number &&
        request.resource.data.pontuacao >= 0 &&
        request.resource.data.pontuacao <= 5000 &&

        request.resource.data.acertos is number &&
        request.resource.data.acertos >= 0 &&
        request.resource.data.acertos <= 8 &&

        // Obriga o uso de FieldValue.serverTimestamp() no cliente: o valor
        // gravado precisa ser exatamente o horário do servidor no momento
        // da escrita, impedindo que o navegador do jogador falsifique a data.
        request.resource.data.data == request.time;

      // Atualização (rodadas seguintes): só o dono do uid pode somar
      // pontos ao próprio total, e cada incremento tem o mesmo teto de
      // uma rodada (5000 pontos / 8 acertos) — o total nunca pode
      // diminuir nem saltar mais do que uma rodada permite.
      allow update: if
        request.auth != null &&
        scoreId == request.auth.uid + '_' + resource.data.categoria &&
        request.resource.data.keys().hasOnly(['categoria', 'nome', 'pontuacao', 'acertos', 'data']) &&
        request.resource.data.categoria == resource.data.categoria &&

        request.resource.data.nome is string &&
        request.resource.data.nome.size() > 0 &&
        request.resource.data.nome.size() <= 20 &&

        request.resource.data.pontuacao is number &&
        request.resource.data.pontuacao >= resource.data.pontuacao &&
        request.resource.data.pontuacao - resource.data.pontuacao <= 5000 &&

        request.resource.data.acertos is number &&
        request.resource.data.acertos >= resource.data.acertos &&
        request.resource.data.acertos - resource.data.acertos <= 8 &&

        request.resource.data.data == request.time;

      // Nenhum documento pode ser apagado.
      allow delete: if false;
    }
  }
}
